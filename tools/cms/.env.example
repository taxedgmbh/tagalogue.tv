# ── Required, always ─────────────────────────────────────────────────────
# The password for the editor. Without it nobody can sign in and the tool
# locks itself; the catalog the televisions read stays up regardless.
# Rotating this invalidates every open session.
CMS_PASSWORD=

# ── Storage ──────────────────────────────────────────────────────────────
# Local mode needs nothing else at all — it writes to tools/cms/.data and serves
# from there, so the whole tool can be used and tested before any account
# exists. This is the default.
STORAGE=local

# The public address this tool is reachable at. The Apple TV reads
# $PUBLIC_BASE_URL/api/catalog, so in local mode set it to your Mac's LAN
# address, not localhost — the television cannot resolve localhost.
PUBLIC_BASE_URL=http://192.168.0.14:4000

# ── Cloud mode ───────────────────────────────────────────────────────────
# STORAGE=cloudflare
# CF_ACCOUNT_ID=
# CF_API_TOKEN=            # Stream:Edit, and R2 read/write
# CF_CUSTOMER_CODE=        # the customer-<CODE> subdomain on the Stream page
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=      # https://pub-<hash>.r2.dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
